<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Animus.ViewModels"
             xmlns:svc="using:Animus.Services"
             x:Class="Animus.Views.DoxView"
             x:DataType="vm:DoxViewModel">

  <!-- A consulta fica fixa em cima; o resultado rola sozinho no espaço que sobra.
       Assim a lista tem altura definida e a virtualização funciona: mesmo com
       centenas de blocos, só os visíveis existem na tela. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="18">

    <!-- ===================== CONSULTA ===================== -->
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="16">

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="34" Height="34" CornerRadius="10"
                  Background="{DynamicResource AnimusAccentSoft}">
            <PathIcon Width="17" Height="17"
                      Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                      Foreground="{DynamicResource AnimusAccent}" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Nova consulta" Classes="h2" />
            <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}"
                       Text="escolha a consulta e informe o valor" />
          </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="10">
          <ComboBox Grid.Column="0" Classes="field" ItemsSource="{Binding Options}"
                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="svc:DoxOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBox Grid.Column="1" Classes="field" Text="{Binding Query}"
                   Watermark="{Binding Placeholder}" IsEnabled="{Binding !IsLoading}" />

          <Button Grid.Column="2" Classes="accent" Content="Consultar"
                  IsDefault="True" IsEnabled="{Binding !IsLoading}"
                  Command="{Binding ConsultarCommand}" />
        </Grid>

        <!-- carregando / erro -->
        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsLoading}">
          <Ellipse Classes="pulse" Width="9" Height="9" VerticalAlignment="Center"
                   Fill="{DynamicResource AnimusAccent}" />
          <TextBlock Text="Consultando…" Classes="muted" VerticalAlignment="Center" />
          <Button Classes="ghost" Content="Cancelar" Padding="12,6"
                  Command="{Binding CancelarCommand}" />
        </StackPanel>

        <Border IsVisible="{Binding HasError}" Padding="14,12"
                CornerRadius="{DynamicResource RadControl}"
                Background="#26ff5468" BorderBrush="{DynamicResource AnimusDanger}" BorderThickness="1">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#ffb3bd" TextWrapping="Wrap" />
        </Border>

      </StackPanel>
    </Border>

    <!-- ===================== RESULTADO ===================== -->
    <Border Grid.Row="1" Classes="card" IsVisible="{Binding HasResult}" VerticalAlignment="Top">
      <DockPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,14">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Resultado" Classes="h2" />
            <TextBlock Text="{Binding Summary}" Classes="muted"
                       FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- ===================== FILTROS =====================
               Menu suspenso: não rouba altura do resultado. Cada filtro só aparece
               se o resultado tiver aquele dado (nome traz estado/idade/gênero,
               telefone traz estado/WhatsApp); no CPF o botão nem existe. -->
          <Button Grid.Column="1" Classes="tab" VerticalAlignment="Center"
                  IsVisible="{Binding CanFilter}"
                  Classes.selected="{Binding Filter.IsActive}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="14" Height="14"
                        Data="M3,2H21V2H21V4H20.92L14,10.92V22.91L10,18.91V10.91L3.09,4H3V2Z" />
              <TextBlock Text="Filtros" VerticalAlignment="Center" />
              <PathIcon Width="11" Height="11" Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" />
            </StackPanel>

            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="dox-filter">
                <StackPanel Spacing="14" MinWidth="330" MaxWidth="380">

                  <TextBox Classes="field" Text="{Binding Filter.Text}"
                           Watermark="Buscar em qualquer campo…" />

                  <!-- estado -->
                  <StackPanel Spacing="6" IsVisible="{Binding Filter.HasUf}">
                    <TextBlock Text="ESTADO" Classes="label" Margin="0" />
                    <ComboBox Classes="field" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Filter.UfOptions}"
                              SelectedItem="{Binding Filter.SelectedUf, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:DoxFilterOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <!-- idade -->
                  <StackPanel Spacing="6" IsVisible="{Binding Filter.HasAge}">
                    <TextBlock Text="IDADE" Classes="label" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBox Classes="field" Width="76" Watermark="de" Text="{Binding Filter.MinAge}" />
                      <TextBlock Text="até" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Classes="field" Width="76" Watermark="até" Text="{Binding Filter.MaxAge}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- gênero -->
                  <StackPanel Spacing="6" IsVisible="{Binding Filter.HasGender}">
                    <TextBlock Text="GÊNERO" Classes="label" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="tab" Classes.selected="{Binding Filter.IsAnyGender}"
                              Content="Todos" Command="{Binding Filter.SetGenderCommand}" />
                      <Button Classes="tab" Classes.selected="{Binding Filter.IsMale}"
                              Content="Homem" Command="{Binding Filter.SetGenderCommand}"
                              CommandParameter="M" />
                      <Button Classes="tab" Classes.selected="{Binding Filter.IsFemale}"
                              Content="Mulher" Command="{Binding Filter.SetGenderCommand}"
                              CommandParameter="F" />
                    </StackPanel>
                  </StackPanel>

                  <!-- whatsapp -->
                  <Button Classes="tab" HorizontalAlignment="Left"
                          Classes.selected="{Binding Filter.OnlyWhatsapp}"
                          IsVisible="{Binding Filter.HasWhatsapp}"
                          Command="{Binding Filter.ToggleWhatsappCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Width="14" Height="14"
                                Data="M12.04,2C6.58,2 2.13,6.45 2.13,11.91C2.13,13.66 2.59,15.36 3.45,16.86L2.05,22L7.3,20.62C8.75,21.41 10.38,21.83 12.04,21.83C17.5,21.83 21.95,17.38 21.95,11.92C21.95,9.27 20.92,6.78 19.05,4.91C17.18,3.03 14.69,2 12.04,2M12.05,3.67C14.25,3.67 16.31,4.53 17.87,6.09C19.42,7.65 20.28,9.72 20.28,11.92C20.28,16.46 16.58,20.15 12.04,20.15C10.56,20.15 9.11,19.76 7.85,19L7.55,18.83L4.43,19.65L5.26,16.61L5.06,16.29C4.24,15 3.8,13.47 3.8,11.91C3.81,7.37 7.5,3.67 12.05,3.67M8.53,7.33C8.37,7.33 8.1,7.39 7.87,7.64C7.65,7.89 7,8.5 7,9.71C7,10.93 7.89,12.1 8,12.27C8.14,12.44 9.76,14.94 12.25,16C12.84,16.27 13.3,16.42 13.66,16.53C14.25,16.72 14.79,16.69 15.22,16.63C15.7,16.56 16.68,16.03 16.89,15.45C17.1,14.87 17.1,14.38 17.04,14.27C16.97,14.17 16.81,14.11 16.56,14C16.31,13.86 15.09,13.26 14.87,13.18C14.64,13.1 14.5,13.06 14.31,13.3C14.15,13.55 13.67,14.11 13.53,14.27C13.38,14.44 13.24,14.46 13,14.34C12.74,14.21 11.94,13.95 11,13.11C10.26,12.45 9.77,11.64 9.62,11.39C9.5,11.15 9.61,11 9.73,10.89C9.84,10.78 10,10.6 10.1,10.45C10.23,10.31 10.27,10.2 10.35,10.04C10.43,9.87 10.39,9.73 10.33,9.61C10.27,9.5 9.77,8.26 9.56,7.77C9.36,7.29 9.16,7.35 9,7.34C8.86,7.34 8.7,7.33 8.53,7.33Z" />
                      <TextBlock Text="Só com WhatsApp" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Border Classes="divider" IsVisible="{Binding Filter.IsActive}" />
                  <Button Classes="ghost" HorizontalAlignment="Stretch"
                          Content="Limpar filtros"
                          IsVisible="{Binding Filter.IsActive}"
                          Command="{Binding Filter.ClearCommand}" />

                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center"
                  Command="{Binding CopyAllCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="15" Height="15"
                        Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" />
              <TextBlock Text="Copiar tudo (TXT)" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- nada bateu com o filtro -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsEmptyByFilter}" Margin="0,0,0,12" Padding="14,12"
                CornerRadius="{DynamicResource RadControl}"
                Background="{DynamicResource AnimusPanel2}"
                BorderBrush="{DynamicResource AnimusBorder2}" BorderThickness="1">
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Nenhum registro bate com o filtro. Ajuste os critérios ou clique em Limpar filtros." />
        </Border>

        <!-- aviso de resposta cortada -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsTruncated}" Margin="0,0,0,12" Padding="12,9"
                CornerRadius="{DynamicResource RadControl}"
                Background="{DynamicResource AnimusPanel2}"
                BorderBrush="{DynamicResource AnimusBorder2}" BorderThickness="1">
          <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource FsSmall}"
                     Text="A fonte devolveu informação demais e parte foi omitida. Refine a busca para ver tudo." />
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Blocks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DoxBlockViewModel">
                <Border Classes="dox-block" Classes.sub="{Binding !IsSection}"
                        Margin="{Binding Margin}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}"
                               Classes="label dox-title" Classes.section="{Binding IsSection}"
                               Margin="0" />

                    <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:DoxFieldViewModel">
                          <Button Classes="field-copy" Command="{Binding CopyCommand}"
                                  MaxWidth="380" Margin="0,0,10,10">
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" Classes="muted"
                                         FontSize="{DynamicResource FsMicro}" LetterSpacing="0.5" />
                              <TextBlock Text="{Binding Value}" FontWeight="Medium"
                                         FontSize="{DynamicResource FsBody}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

  </Grid>

</UserControl>
