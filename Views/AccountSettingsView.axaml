<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Animus.ViewModels"
             x:Class="Animus.Views.AccountSettingsView"
             x:DataType="vm:AccountSettingsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.msg">
      <Setter Property="FontSize" Value="{DynamicResource FsSubtitle}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource AnimusDanger}" />
    </Style>
    <Style Selector="TextBlock.msg.ok">
      <Setter Property="Foreground" Value="{DynamicResource AnimusAccent}" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Width" Value="430" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card">
    <StackPanel Spacing="16">

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="34" Height="34" CornerRadius="10"
                Background="{DynamicResource AnimusAccentSoft}">
          <PathIcon Width="17" Height="17"
                    Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                    Foreground="{DynamicResource AnimusAccent}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Alterar senha" Classes="h2" />
          <TextBlock Classes="muted" FontSize="{DynamicResource FsSmall}"
                     Text="{Binding UserName, StringFormat='conta: {0}'}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Text="SENHA ATUAL" Classes="label" Margin="0" />
        <TextBox Classes="field" Text="{Binding CurrentPassword}" PasswordChar="●" />
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Text="NOVA SENHA" Classes="label" Margin="0" />
        <TextBox Classes="field" Text="{Binding NewPassword}" PasswordChar="●" />
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Text="CONFIRMAR NOVA SENHA" Classes="label" Margin="0" />
        <TextBox Classes="field" Text="{Binding ConfirmPassword}" PasswordChar="●" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="16">
        <Button Classes="accent" Content="Salvar senha" Command="{Binding ChangePasswordCommand}" />
        <TextBlock Classes="msg" Classes.ok="{Binding PasswordSucceeded}"
                   Text="{Binding PasswordMessage}"
                   IsVisible="{Binding HasPasswordMessage}"
                   VerticalAlignment="Center" MaxWidth="380" />
      </StackPanel>

    </StackPanel>
  </Border>

</UserControl>
